# Generated by scripts/homebrew.rb in datadog-labs/bits-cli from
# .github/homebrew/bits.rb.erb; change the formula there.
class Bits < Formula
  desc "Datadog Assistant in your terminal"
  homepage "https://github.com/datadog-labs/bits-cli"
  license "Apache-2.0"

  on_macos do
    # Bits is released for Apple silicon only on macOS.
    depends_on arch: :arm64

    on_arm do
      url "https://github.com/datadog-labs/bits-cli/releases/download/v<%= values.fetch("version") %>/bits_<%= values.fetch("version") %>_darwin_arm64.tar.gz"
      sha256 "<%= values.fetch("sha256_darwin_arm64") %>"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/datadog-labs/bits-cli/releases/download/v<%= values.fetch("version") %>/bits_<%= values.fetch("version") %>_linux_arm64.tar.gz"
      sha256 "<%= values.fetch("sha256_linux_arm64") %>"
    end
    on_intel do
      url "https://github.com/datadog-labs/bits-cli/releases/download/v<%= values.fetch("version") %>/bits_<%= values.fetch("version") %>_linux_amd64.tar.gz"
      sha256 "<%= values.fetch("sha256_linux_amd64") %>"
    end
  end

  def install
    bin.install "bits"
  end

  test do
    assert_equal "bits version v#{version}", shell_output("#{bin}/bits --version").strip
  end
end
